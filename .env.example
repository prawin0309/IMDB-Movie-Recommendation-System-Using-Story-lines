# Copy to .env (or export these in your shell) to override the defaults.
# .env is gitignored - never commit real credentials.

# Database backend: auto | mysql | sqlite
# auto  -> try MySQL, fall back to SQLite so the project runs anywhere
IMDB_DB_BACKEND=auto

IMDB_DB_HOST=localhost
IMDB_DB_PORT=3306
IMDB_DB_USER=root
IMDB_DB_PASSWORD=change-me
IMDB_DB_NAME=guvi_db

# Run the Selenium scraper without a visible browser window
IMDB_HEADLESS=1
